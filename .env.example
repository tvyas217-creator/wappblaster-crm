PORT=3000
NODE_ENV=production
# Generate a unique random secret of 32+ characters. Do not use this example value.
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Optional initial workspace and first admin account (only used when the database is empty)
COMPANY_NAME=Your Company
COMPANY_SLUG=your-company
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=replace-with-a-strong-password
# For Render persistent disk, set DATA_DIR=/var/data
DATA_DIR=./data
